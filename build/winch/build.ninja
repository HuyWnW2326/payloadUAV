  INCLUDES = -I/home/huy/CTUAV/payloadUAV/apps/include -I/home/huy/CTUAV/payloadUAV/build/winch/apps/include -I/home/huy/CTUAV/payloadUAV/build/winch/apps/builtin -isystem /home/huy/CTUAV/payloadUAV/nuttx/include -isystem /home/huy/CTUAV/payloadUAV/build/winch/include
