# Object build statements for STATIC_LIBRARY target apps_builtin


#############################################
# Order-only phony target for apps_builtin

build cmake_object_order_depends_target_apps_builtin: phony || apps_context nuttx_context

build apps/builtin/CMakeFiles/apps_builtin.dir/builtin_list.c.o: C_COMPILER__apps_builtin_ /home/huy/CTUAV/payloadUAV/apps/builtin/builtin_list.c || cmake_object_order_depends_target_apps_builtin
  DEFINES = -D__NuttX__
  DEP_FILE = apps/builtin/CMakeFiles/apps_builtin.dir/builtin_list.c.o.d
  FLAGS = -mtune=cortex-m4 -march=armv7e-m -mfloat-abi=soft -fno-common -Wall -Wshadow -Wundef -nostdlib -Os -fno-strict-aliasing -fomit-frame-pointer -mthumb -Wa,-mthumb -Wa,-mimplicit-it=always -ffunction-sections -fdata-sections -Wno-attributes -Wno-unknown-pragmas -Wstrict-prototypes -Wno-psabi -fdiagnostics-color=always -fmacro-prefix-map=/home/huy/CTUAV/payloadUAV/nuttx= -fmacro-prefix-map=/home/huy/CTUAV/payloadUAV/apps= -fmacro-prefix-map=/home/huy/CTUAV/payloadUAV/boards/arm/stm32/stm32f411-minimum= -fmacro-prefix-map=/home/huy/CTUAV/payloadUAV/nuttx/arch/arm/src/stm32= -DNDEBUG
  INCLUDES = -I/home/huy/CTUAV/payloadUAV/apps/include -I/home/huy/CTUAV/payloadUAV/build/winch/apps/include -I/home/huy/CTUAV/payloadUAV/build/winch/apps/builtin -isystem /home/huy/CTUAV/payloadUAV/nuttx/include -isystem /home/huy/CTUAV/payloadUAV/build/winch/include
  OBJECT_DIR = apps/builtin/CMakeFiles/apps_builtin.dir
  OBJECT_FILE_DIR = apps/builtin/CMakeFiles/apps_builtin.dir
  TARGET_COMPILE_PDB = apps/builtin/CMakeFiles/apps_builtin.dir/apps_builtin.pdb
  TARGET_PDB = apps/builtin/libapps_builtin.pdb
  RSP_FILE = apps/builtin/CMakeFiles/apps_builtin.dir/builtin_list.c.o.rsp

build apps/builtin/CMakeFiles/apps_builtin.dir/exec_builtin.c.o: C_COMPILER__apps_builtin_ /home/huy/CTUAV/payloadUAV/apps/builtin/exec_builtin.c || cmake_object_order_depends_target_apps_builtin
